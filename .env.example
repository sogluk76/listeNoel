# Copier ce fichier en .env et adapter les valeurs. Le fichier .env ne doit jamais être commité.

# Clé de signature des sessions. Obligatoire en production.
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(48))"
# En local, si elle est absente, une clé est créée automatiquement dans data/secret_key.
NOEL_SECRET_KEY=

# Mettre à true en production (HTTPS) pour que le cookie de session soit « Secure ».
NOEL_SECURE_COOKIES=false

# Facultatif : emplacement de la base et des images.
# NOEL_DATABASE_URL=sqlite:///data/app.db
# NOEL_MEDIA_DIR=media
# Photos des messages privés (jamais servies en statique).
# NOEL_PRIVATE_MEDIA_DIR=media_private
